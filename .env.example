CHAT_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=your-model-name
CHAT_API_KEY=your-api-key
CHAT_TEMPERATURE=0.2
CHAT_CONTEXT_TOKEN_BUDGET=6000
CHAT_TOKEN_SAFETY_MARGIN=500
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=mewhelp
MYSQL_USER=mewhelp
MYSQL_PASSWORD=mewhelp
TOOL_TIMEOUT_SECONDS=10

# ---- ch03 · RAG 基础 ----
# 嵌入服务：去硅基流动 https://siliconflow.cn 申请 API Key（与 CHAT_API_KEY 不通用）。
# 为空时向量检索自动降级为关键词查表，离线建库脚本会跳过真实嵌入调用。
EMBED_API_KEY=
# 嵌入服务地址与模型（OpenAI 兼容 /embeddings 接口，BAAI/bge-m3 输出 1024 维）
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
# Milvus standalone 地址（compose.yaml 起的容器，本章升到 2.5.x 以支持 BM25）
MILVUS_URI=http://localhost:19530

# ---- ch04 · RAG 进阶：混合检索 / 重排 / 评估 ----
# 在线默认检索策略：vector / bm25 / hybrid / hybrid_rerank
RETRIEVAL_STRATEGY=hybrid_rerank
# BM25 与 dense 单路各召回条数、RRF 融合参数 k
RECALL_TOP_K=50
RRF_RANK_CONSTANT=60
# 重排服务（硅基流动 /rerank，BAAI/bge-reranker-v2-m3）。与 EMBED_API_KEY 同一把 Key。
# 为空时重排自动降级为混合序，在线链路不中断。
RERANK_API_KEY=
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 精排保留条数与机械闸阈值（最高相关度低于该值判证据不足并落低置信度池）
RERANK_TOP_N=10
RERANK_MIN_SCORE=0.3
# 语义闸自评温度
SELF_CHECK_TEMPERATURE=0.0
# 评估裁判模型（忠实度/覆盖度打分）
JUDGE_MODEL=deepseek-v4-pro
# 评估指标 K（MRR@5 / Recall@5）
EVAL_TOP_K=5

# ---- ch08 · 即插即用工具系统 ----
# 自建业务 MCP Server（Streamable HTTP，scripts/mcp_up.py 拉起）
MCP_LOGISTICS_URL=http://127.0.0.1:8101/mcp
MCP_AFTERSALES_URL=http://127.0.0.1:8102/mcp
# 内置/MCP 工具默认超时（秒）与只读工具暂时性故障最大重试次数（写操作恒不重试）
TOOL_DEFAULT_TIMEOUT=5.0
MCP_TOOL_TIMEOUT=10.0
TOOL_MAX_RETRIES=2
# 验收6：>0 时 create_ticket 人为变慢（写超时演示）
DEMO_TICKET_DELAY_SECONDS=0
